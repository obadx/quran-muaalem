name: "muaalem"
platform: "pytorch_libtorch"

max_batch_size: 32

input [
  {
    name: "INPUT__0"
    data_type: TYPE_FP16
    dims: [ -1, 160 ]
  }
]

output [
  {
    name: "OUTPUT__0"
    data_type: TYPE_FP16
    dims: [ -1, 43 ]   
  },
  {
    name: "OUTPUT__1"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "OUTPUT__2"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 2, 4, 8, 16, 32 ]
  max_queue_delay_microseconds: 50000
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]